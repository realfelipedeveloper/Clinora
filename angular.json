{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "analytics": false
  },
  "newProjectRoot": "apps",
  "projects": {
    "web": {
      "projectType": "application",
      "schematics": {},
      "root": "apps/web",
      "sourceRoot": "apps/web/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/web/src/main.ts",
            "tsConfig": "apps/web/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/web/public"
              }
            ],
            "styles": ["apps/web/src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "web:build:production"
            },
            "development": {
              "buildTarget": "web:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "coverage": true,
            "coverageInclude": ["apps/web/src/**/*.ts"],
            "coverageExclude": ["**/*.spec.ts", "**/*.test.ts"],
            "coverageThresholds": {
              "statements": 50,
              "branches": 90,
              "functions": 50,
              "lines": 25
            }
          }
        }
      }
    },
    "clinora-ui": {
      "projectType": "library",
      "root": "libs/typescript/clinora-ui",
      "sourceRoot": "libs/typescript/clinora-ui/src",
      "prefix": "clinora",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "libs/typescript/clinora-ui/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "libs/typescript/clinora-ui/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "libs/typescript/clinora-ui/tsconfig.spec.json",
            "coverage": true,
            "coverageInclude": ["libs/typescript/clinora-ui/src/**/*.ts"],
            "coverageExclude": ["**/*.spec.ts", "**/*.test.ts", "**/*.stories.ts"],
            "coverageThresholds": {
              "statements": 85,
              "branches": 85,
              "functions": 70,
              "lines": 90
            }
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "browserTarget": "web:build",
            "configDir": "libs/typescript/clinora-ui/.storybook",
            "tsConfig": "libs/typescript/clinora-ui/tsconfig.storybook.json",
            "port": 44212,
            "host": "127.0.0.1",
            "open": false,
            "compodoc": false,
            "styles": ["apps/web/src/styles.css"]
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "browserTarget": "web:build",
            "configDir": "libs/typescript/clinora-ui/.storybook",
            "tsConfig": "libs/typescript/clinora-ui/tsconfig.storybook.json",
            "outputDir": "dist/storybook/clinora-ui",
            "compodoc": false,
            "styles": ["apps/web/src/styles.css"]
          }
        }
      }
    },
    "docs": {
      "projectType": "application",
      "schematics": {},
      "root": "apps/docs",
      "sourceRoot": "apps/docs/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/docs/src/main.ts",
            "tsConfig": "apps/docs/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/docs/public"
              },
              {
                "glob": "**/*.md",
                "input": "docs",
                "output": "content"
              },
              {
                "glob": "spec.md",
                "input": "specs/001-platform-foundation",
                "output": "specs/001-platform-foundation"
              }
            ],
            "styles": ["apps/docs/src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "docs:build:production"
            },
            "development": {
              "buildTarget": "docs:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "coverage": true,
            "coverageInclude": ["apps/docs/src/**/*.ts"],
            "coverageExclude": ["**/*.spec.ts", "**/*.test.ts"],
            "coverageThresholds": {
              "statements": 70,
              "branches": 60,
              "functions": 70,
              "lines": 60
            }
          }
        }
      }
    }
  }
}
