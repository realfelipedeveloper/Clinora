{
  "realm": "clinora",
  "enabled": true,
  "sslRequired": "none",
  "clientScopes": [
    {
      "name": "clinora",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    }
  ],
  "clients": [
    {
      "clientId": "clinora-web",
      "name": "Clinora Web",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": ["clinora"],
      "redirectUris": ["http://127.0.0.1:44210/*"],
      "webOrigins": ["http://127.0.0.1:44210"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "clinora-core-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "clinora-core",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "clinora-smoke",
      "name": "Clinora Local Smoke",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "secret": "clinora_smoke_local_only_2026",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["clinora"],
      "protocolMappers": [
        {
          "name": "clinora-core-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "clinora-core",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ]
}
