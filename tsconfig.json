{
  "compileOnSave": false,
  "compilerOptions": {
    "paths": {
      "clinora-ui": ["./dist/clinora-ui"]
    },
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./apps/web/tsconfig.app.json"
    },
    {
      "path": "./apps/web/tsconfig.spec.json"
    },
    {
      "path": "./libs/typescript/clinora-ui/tsconfig.lib.json"
    },
    {
      "path": "./libs/typescript/clinora-ui/tsconfig.spec.json"
    },
    {
      "path": "./apps/docs/tsconfig.app.json"
    },
    {
      "path": "./apps/docs/tsconfig.spec.json"
    }
  ]
}
