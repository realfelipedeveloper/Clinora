{
  "realm": "clinora",
  "enabled": true,
  "sslRequired": "none",
  "browserFlow": "clinora-browser",
  "authenticationFlows": [
    {
      "alias": "clinora-browser",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-cookie", "requirement": "ALTERNATIVE", "priority": 10 },
        { "authenticatorFlow": true, "flowAlias": "clinora-form", "requirement": "ALTERNATIVE", "priority": 20 }
      ]
    },
    {
      "alias": "clinora-form",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticatorFlow": true, "flowAlias": "clinora-loa-1", "requirement": "CONDITIONAL", "priority": 10 },
        { "authenticatorFlow": true, "flowAlias": "clinora-loa-2", "requirement": "CONDITIONAL", "priority": 20 }
      ]
    },
    {
      "alias": "clinora-loa-1",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "conditional-level-of-authentication", "authenticatorConfig": "clinora-condition-loa-1", "requirement": "REQUIRED", "priority": 10 },
        { "authenticator": "auth-username-password-form", "requirement": "REQUIRED", "priority": 20 }
      ]
    },
    {
      "alias": "clinora-loa-2",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "conditional-level-of-authentication", "authenticatorConfig": "clinora-condition-loa-2", "requirement": "REQUIRED", "priority": 10 },
        { "authenticator": "auth-otp-form", "requirement": "REQUIRED", "priority": 20 }
      ]
    }
  ],
  "authenticatorConfig": [
    { "alias": "clinora-condition-loa-1", "config": { "loa-condition-level": "1", "loa-max-age": "36000" } },
    { "alias": "clinora-condition-loa-2", "config": { "loa-condition-level": "2", "loa-max-age": "0" } }
  ],
  "clientScopes": [
    {
      "name": "clinora",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    }
  ],
  "clients": [
    {
      "clientId": "clinora-web",
      "name": "Clinora Web",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": ["clinora"],
      "redirectUris": ["http://127.0.0.1:44210/*"],
      "webOrigins": ["http://127.0.0.1:44210"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "clinora-core-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "clinora-core",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "clinora-smoke",
      "name": "Clinora Local Smoke",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "secret": "clinora_smoke_local_only_2026",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["clinora"],
      "protocolMappers": [
        {
          "name": "clinora-core-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "clinora-core",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ]
}
