{
  "name": "clinora",
  "version": "0.0.0",
  "private": true,
  "description": "Clinora monorepo foundation.",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=11.20.0 <12"
  },
  "scripts": {
    "ng": "ng",
    "doctor": "node tools/clinora.mjs doctor",
    "verify": "node tools/clinora.mjs verify",
    "java:verify": "node tools/clinora.mjs java:verify",
    "frontend:check": "node tools/clinora.mjs frontend:check",
    "frontend:verify": "node tools/clinora.mjs frontend:verify",
    "tools:test": "node tools/clinora.mjs tools:test",
    "security:check": "node tools/clinora.mjs security:check",
    "frontend:version": "ng version",
    "frontend:workspace": "ng config cli.packageManager",
    "web:serve": "ng serve web --host 127.0.0.1 --port 44210",
    "web:build": "ng build web",
    "web:test": "ng test web --watch=false",
    "ui:build": "ng build clinora-ui",
    "ui:test": "ng test clinora-ui --watch=false",
    "ui:storybook": "ng run clinora-ui:storybook",
    "ui:storybook:build": "ng run clinora-ui:build-storybook",
    "e2e:test": "playwright test",
    "e2e:install": "playwright install chromium",
    "git:remote": "node tools/clinora.mjs git:remote",
    "commitlint": "commitlint --from=HEAD~1 --to=HEAD --verbose"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/platform-browser-dynamic": "22.2.3",
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "1.64.1",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/angular": "10.6.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitest/coverage-v8": "4.1.12",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
    "postcss": "^8.5.31",
    "prettier": "^3.8.1",
    "storybook": "10.6.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
